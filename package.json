{
  "name": "lantern",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"bun run dev:server\" \"bun run dev:ui\"",
    "dev:server": "bun --watch src/server.ts",
    "dev:ui": "vite --config vite.config.ts",
    "build:ui": "vite build",
    "start": "bun run build:ui && bun run src/server.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.99.0",
    "@google/generative-ai": "0.24.1",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "hono": "^4.6.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.460.0",
    "playwright": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0-beta",
    "@tailwindcss/vite": "^4.0.0-beta",
    "concurrently": "^9.0.0"
  }
}
